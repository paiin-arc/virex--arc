{
  "name": "virex",
  "version": "1.0.0",
  "description": "Virex: Intent-Based Cross-Chain USDC Router",
  "main": "index.js",
  "scripts": {
    "init:backend": "cd backend && npm install",
    "init:frontend": "cd frontend && npm install",
    "dev": "npx -y concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev -- --port 3000 --host",
    "build:frontend": "cd frontend && npm run build",
    "test:contracts": "cd contracts && forge test"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
